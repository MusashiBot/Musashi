# Musashi MCP Server - Environment Variables

# REQUIRED for HTTP transport
MCP_API_KEYS=mcp_sk_your_admin_key_here,mcp_sk_another_key_here

# Server configuration
PORT=3000
NODE_ENV=production

# REST API endpoint (defaults to production)
MUSASHI_API_BASE_URL=https://musashi-api.vercel.app

# Optional: Rate limiting
MCP_RATE_LIMIT_PER_MINUTE=60
MCP_RATE_LIMIT_PER_HOUR=1000

# Optional: Logging
LOG_LEVEL=info
